# Database
DATABASE_URL="postgresql://user:password@localhost:5432/bio_sculpture?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# Public site URL used in email links (falls back to NEXTAUTH_URL)
# NEXT_PUBLIC_SITE_URL="https://www.example.com"
# EMAIL_SITE_URL="https://biosculpture.pt"

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Brevo transactional email (https://app.brevo.com)
# Preferred: API key from Settings → SMTP & API → API keys
BREVO_API_KEY=""
# Must be a verified sender in Brevo
BREVO_FROM="Bio Sculpture <noreply@yourdomain.com>"

# Optional: Brevo SMTP relay instead of API (smtp-relay.brevo.com)
# Use SMTP login + SMTP key from Brevo (not the API key)
# BREVO_SMTP_LOGIN="your-brevo-login-email"
# BREVO_SMTP_KEY="your-brevo-smtp-key"
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_FROM falls back from BREVO_FROM if unset
# SMTP_FROM="Bio Sculpture <noreply@yourdomain.com>"

# Cron secret for POST/GET /api/cron/emails
# Pass via header only (Authorization: Bearer <secret> or X-Cron-Secret: <secret>).
# Do NOT put the secret in the URL (?secret=) — it can leak in access/proxy logs.
CRON_SECRET="generate-with-openssl-rand-hex-32"
# Optional timing overrides (defaults shown)
# REVIEW_DELAY_DAYS="4"
# ABANDONMENT_DAYS="5"
# OFFLINE_PAYMENT_EXPIRY_DAYS="5"
# CODE_TTL_MINUTES="30"
# RESET_TTL_HOURS="1"

# Offline checkout payments (MB Way / bank transfer)
# Also editable in Admin → Payment Instructions. Env values are defaults when DB is empty.
# CHECKOUT_MBWAY_PHONE="+351 935 172 295"
# CHECKOUT_BANK_ACCOUNT_NAME="BS Gel lda"
# CHECKOUT_BANK_NAME="Santander"
# CHECKOUT_BANK_IBAN="PT50001800032118736402088"
# CHECKOUT_BANK_BIC=""

# Admin AI Assistant (Gemini)
# Set ENABLE_ADMIN_AI=true to show the chat widget in /admin (localhost or production).
# When false or unset, the widget is hidden and AI APIs are disabled.
ENABLE_ADMIN_AI="false"
NEXT_PUBLIC_ENABLE_ADMIN_AI="false"
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override model (default: gemini-3.1-flash-lite)
# GEMINI_MODEL="gemini-3.1-flash-lite"

# Sentry error monitoring (optional — disabled when DSN unset)
# Create a Next.js project at https://sentry.io then paste the DSN:
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"
# SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"
# Optional source-map upload during CI/build:
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"
# SENTRY_AUTH_TOKEN="sntrys_..."

