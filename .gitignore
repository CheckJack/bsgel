# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# User / admin uploaded media (MUST survive deploys — never commit binaries)
# Keep the directory in git via .gitkeep; ignore contents.
/uploads/
/public/uploads/**
!/public/uploads/.gitkeep
*.pem

# Database dumps from npm run db:backup
/database-backups/

# large media (exceeds GitHub 100MB limit)
Bio Sculpture Brand Video.mp4
public/Bio Sculpture Brand Video.mp4

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sentry CLI / build artifacts
.sentryclirc

# exports
#/exports
