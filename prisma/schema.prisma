generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  password           String
  name               String?
  image              String?
  role               UserRole            @default(USER)
  permissions        Json?
  isActive           Boolean             @default(true)
  lastLoginAt        DateTime?
  certificationId    String?
  certificateUrl     String?
  shippingAddress    String?
  pointsBalance      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  adminLogs          AdminLog[]          @relation("AdminLogs")
  affiliate          Affiliate?
  affiliateReferral  AffiliateReferral?  @relation("ReferredUser")
  cart               Cart?
  chatMessages       ChatMessage[]
  comments           Comment[]
  notifications      Notification[]
  orders             Order[]
  pointsRedemptions  PointsRedemption[]
  pointsTransactions PointsTransaction[]
  productReviews     ProductReview[]
  salon              Salon?
  trainingBookings   TrainingBooking[]
  certification      Certification?      @relation(fields: [certificationId], references: [id])

  @@index([certificationId])
}

model Category {
  id                      String                  @id @default(cuid())
  name                    String
  slug                    String                  @unique
  description             String?
  image                   String?
  icon                    String?
  parentId                String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  parent                  Category?               @relation("CategorySubcategories", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories           Category[]              @relation("CategorySubcategories")
  certificationCategories CertificationCategory[]
  products                Product[]
  productSubcategories    ProductSubcategory[]

  @@index([parentId])
}

model Product {
  id                 String                   @id @default(cuid())
  name               String
  description        String?
  price              Decimal                  @db.Decimal(10, 2)
  salePrice          Decimal?                 @db.Decimal(10, 2)
  discountPercentage Int?
  image              String?
  images             String[]                 @default([])
  featured           Boolean                  @default(false)
  categoryId         String?
  attributes         Json?
  showcasingSections String[]                 @default([])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  hemaFree           Boolean                  @default(false)
  outOfStock         Boolean                  @default(false)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  category           Category?                @relation(fields: [categoryId], references: [id])
  reviews            ProductReview[]
  subcategories      ProductSubcategory[]
  trainingPrograms   TrainingProgramProduct[]

  @@index([categoryId])
  @@index([featured])
  @@index([price])
  @@index([createdAt])
  @@index([categoryId, featured])
}

model ProductSubcategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  createdAt  DateTime @default(now())
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id                  String             @id @default(cuid())
  userId              String
  total               Decimal            @db.Decimal(10, 2)
  status              OrderStatus        @default(PENDING)
  paymentIntentId     String?            @unique
  shippingAddress     String?
  affiliateReferralId String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  taxAmount           Decimal?           @db.Decimal(10, 2)
  taxRate             Decimal?           @db.Decimal(5, 2)
  taxRegion           String?
  affiliateReferral   AffiliateReferral? @relation(fields: [affiliateReferralId], references: [id])
  user                User               @relation(fields: [userId], references: [id])
  items               OrderItem[]

  @@index([affiliateReferralId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Attribute {
  id        String   @id @default(cuid())
  category  String   @unique
  values    String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id              String          @id @default(cuid())
  name            String
  type            GalleryItemType
  url             String?
  mimeType        String?
  size            Int?
  folderId        String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  coverPictureUrl String?
  optimizeHeight  Int?
  optimizeWidth   Int?
  folder          GalleryItem?    @relation("FolderItems", fields: [folderId], references: [id], onDelete: Cascade)
  items           GalleryItem[]   @relation("FolderItems")

  @@index([folderId])
}

model Salon {
  id              String      @id @default(cuid())
  name            String
  address         String
  city            String
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  latitude        Float?
  longitude       Float?
  image           String?
  logo            String?
  images          String[]    @default([])
  description     String?
  workingHours    Json?
  isActive        Boolean     @default(true)
  isBioDiamond    Boolean     @default(false)
  status          SalonStatus @default(APPROVED)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  userId          String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  user            User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([isActive])
  @@index([isBioDiamond])
  @@index([userId])
  @@index([status])
}

model Notification {
  id           String           @id @default(cuid())
  type         NotificationType
  title        String
  message      String
  image        String?
  read         Boolean          @default(false)
  userId       String?
  linkUrl      String?
  scheduledFor DateTime?
  isScheduled  Boolean          @default(false)
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([read])
  @@index([createdAt])
  @@index([userId])
  @@index([scheduledFor])
  @@index([isScheduled])
}

model ChatMessage {
  id            String    @id @default(cuid())
  userId        String
  message       String
  adminResponse String?
  readByAdmin   Boolean   @default(false)
  readAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readByAdmin])
  @@index([createdAt])
}

model Blog {
  id                 String     @id @default(cuid())
  title              String
  slug               String     @unique
  excerpt            String?
  content            String
  image              String?
  author             String?
  status             BlogStatus @default(DRAFT)
  publishedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  assignedReviewerId String?
  createdBy          String?
  reviewComments     String?
  reviewedAt         DateTime?
  reviewedBy         String?
  comments           Comment[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([assignedReviewerId])
  @@index([createdBy])
}

model Comment {
  id         String       @id @default(cuid())
  blogId     String
  userId     String
  content    String
  status     ReviewStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  blog       Blog         @relation(fields: [blogId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([blogId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model ProductReview {
  id              String       @id @default(cuid())
  productId       String
  userId          String
  rating          Int
  title           String?
  content         String
  verifiedBuyer   Boolean      @default(false)
  helpfulCount    Int          @default(0)
  notHelpfulCount Int          @default(0)
  status          ReviewStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  companyResponse String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([rating])
  @@index([productId, status])
}

model SocialMediaPost {
  id                 String                @id @default(cuid())
  platform           SocialMediaPlatform   @default(INSTAGRAM)
  contentType        ContentType           @default(POST)
  caption            String
  images             String[]              @default([])
  scheduledDate      DateTime
  status             SocialMediaPostStatus @default(DRAFT)
  reviewComments     String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  assignedReviewerId String?
  hashtags           String[]              @default([])
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([platform])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([assignedReviewerId])
}

model EmailCampaign {
  id                 String              @id @default(cuid())
  subject            String
  content            String
  pdfUrl             String?
  scheduledDate      DateTime?
  status             EmailCampaignStatus @default(DRAFT)
  reviewComments     String?
  reviewedBy         String?
  reviewedAt         DateTime?
  createdBy          String?
  assignedReviewerId String?
  recipientList      String[]            @default([])
  recipientType      String              @default("ALL")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
  @@index([assignedReviewerId])
  @@index([createdBy])
}

model Coupon {
  id                          String            @id @default(cuid())
  code                        String            @unique
  description                 String?
  discountType                DiscountType      @default(PERCENTAGE)
  discountValue               Decimal           @db.Decimal(10, 2)
  minPurchaseAmount           Decimal?          @db.Decimal(10, 2)
  maxDiscountAmount           Decimal?          @db.Decimal(10, 2)
  minPurchaseIncludesDelivery Boolean           @default(false)
  usageLimit                  Int?
  usedCount                   Int               @default(0)
  userUsageLimit              Int?
  validFrom                   DateTime          @default(now())
  validUntil                  DateTime?
  isActive                    Boolean           @default(true)
  includedProducts            String[]          @default([])
  excludedProducts            String[]          @default([])
  includedCategories          String[]          @default([])
  excludedCategories          String[]          @default([])
  source                      CouponSource      @default(MANUAL)
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  redemption                  PointsRedemption?

  @@index([code])
  @@index([isActive])
  @@index([validUntil])
  @@index([createdAt])
  @@index([source])
}

model BannedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  bannedBy  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model Certification {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  description             String?
  isActive                Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  certificationCategories CertificationCategory[]
  users                   User[]

  @@index([isActive])
  @@index([name])
}

model CertificationCategory {
  id              String        @id @default(cuid())
  certificationId String
  categoryId      String
  createdAt       DateTime      @default(now())
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  @@unique([certificationId, categoryId])
  @@index([certificationId])
  @@index([categoryId])
}

model MegaMenuCard {
  id        String       @id @default(cuid())
  menuType  MegaMenuType
  position  Int
  imageUrl  String
  linkUrl   String
  mediaType MediaType    @default(IMAGE)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([menuType, position])
  @@index([menuType])
  @@index([isActive])
}

model Page {
  id             String     @id @default(cuid())
  name           String
  slug           String?    @unique
  description    String?
  content        String?
  template       String     @default("Default")
  status         PageStatus @default(DRAFT)
  sections       Json?
  seoTitle       String?
  seoDescription String?
  seoUrl         String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([createdAt])
}

model Affiliate {
  id                   String               @id @default(cuid())
  userId               String               @unique
  affiliateCode        String               @unique
  isActive             Boolean              @default(true)
  approvedAt           DateTime?
  approvedBy           String?
  totalPointsEarned    Int                  @default(0)
  currentPointsBalance Int                  @default(0)
  totalReferrals       Int                  @default(0)
  activeReferrals      Int                  @default(0)
  tier                 AffiliateTier        @default(BRONZE)
  tierUpdatedAt        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkClicks           AffiliateLinkClick[]
  referrals            AffiliateReferral[]

  @@index([affiliateCode])
  @@index([isActive])
  @@index([userId])
}

model AffiliateReferral {
  id             String         @id @default(cuid())
  affiliateId    String
  referredUserId String         @unique
  status         ReferralStatus @default(PENDING)
  firstOrderId   String?
  referralDate   DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  affiliate      Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([affiliateId])
  @@index([referredUserId])
  @@index([status])
  @@index([referralDate])
}

model AffiliateLinkClick {
  id              String    @id @default(cuid())
  affiliateId     String
  clickedAt       DateTime  @default(now())
  ipAddress       String?
  userAgent       String?
  converted       Boolean   @default(false)
  convertedAt     DateTime?
  convertedUserId String?
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([clickedAt])
  @@index([converted])
}

model PointsTransaction {
  id            String                @id @default(cuid())
  userId        String
  amount        Int
  type          PointsTransactionType
  referenceId   String?
  description   String?
  balanceBefore Int
  balanceAfter  Int
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

model Reward {
  id                String             @id @default(cuid())
  name              String
  description       String?
  pointsCost        Int
  discountType      DiscountType       @default(PERCENTAGE)
  discountValue     Decimal            @db.Decimal(10, 2)
  minPurchaseAmount Decimal?           @db.Decimal(10, 2)
  maxDiscountAmount Decimal?           @db.Decimal(10, 2)
  isActive          Boolean            @default(true)
  stock             Int?
  redeemedCount     Int                @default(0)
  validFrom         DateTime           @default(now())
  validUntil        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  redemptions       PointsRedemption[]

  @@index([isActive])
  @@index([pointsCost])
  @@index([validUntil])
}

model PointsRedemption {
  id          String           @id @default(cuid())
  userId      String
  rewardId    String
  pointsSpent Int
  couponCode  String           @unique
  couponId    String           @unique
  status      RedemptionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  coupon      Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  reward      Reward           @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
  @@index([status])
  @@index([createdAt])
}

model PointsConfiguration {
  id                      String                        @id @default(cuid())
  actionType              PointsConfigurationActionType
  pointsAmount            Int?
  tieredConfig            Json?
  minOrderValue           Decimal?                      @db.Decimal(10, 2)
  maxPointsPerTransaction Int?
  isActive                Boolean                       @default(true)
  validFrom               DateTime                      @default(now())
  validUntil              DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@index([actionType])
  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model AdminLog {
  id           String             @id @default(cuid())
  userId       String
  actionType   AdminLogActionType
  resourceType String
  resourceId   String?
  description  String
  details      Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime           @default(now())
  user         User               @relation("AdminLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([actionType])
  @@index([resourceType])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model TrainingProgram {
  id          String                   @id @default(cuid())
  title       String
  description String?
  content     String?
  days        Json?
  totalHours  Int
  price       Decimal                  @db.Decimal(10, 2)
  image       String?
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  bookings    TrainingBooking[]
  products    TrainingProgramProduct[]
  sessions    TrainingSession[]

  @@index([isActive])
  @@index([createdAt])
}

model TrainingProgramProduct {
  id                String          @id @default(cuid())
  trainingProgramId String
  productId         String
  quantity          Int             @default(1)
  createdAt         DateTime        @default(now())
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)

  @@unique([trainingProgramId, productId])
  @@index([trainingProgramId])
  @@index([productId])
}

model TrainingSession {
  id              String            @id @default(cuid())
  programId       String
  startDate       DateTime
  endDate         DateTime
  location        String?
  format          TrainingFormat    @default(PRESENTIAL)
  maxParticipants Int               @default(10)
  currentBookings Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bookings        TrainingBooking[]
  program         TrainingProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([startDate])
  @@index([isActive])
  @@index([startDate, isActive])
  @@index([format])
}

model TrainingBooking {
  id        String                @id @default(cuid())
  userId    String
  programId String
  sessionId String
  status    TrainingBookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  program   TrainingProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  session   TrainingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([programId])
  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
}

model TaxRegion {
  id                 String    @id @default(cuid())
  name               String
  taxRate            Decimal   @db.Decimal(5, 2)
  postalCodePatterns String[]  @default([])
  isActive           Boolean   @default(true)
  validFrom          DateTime  @default(now())
  validUntil         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([isActive])
  @@index([validFrom])
  @@index([validUntil])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  NEW_CUSTOMER
  NEW_PROFESSIONAL_CERTIFICATION
  ORDER
  ORDER_STATUS
  ORDER_SHIPPED
  ORDER_DELIVERED
  SYSTEM
  SALON_REJECTED
  SALON_APPROVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GalleryItemType {
  FILE
  FOLDER
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum SocialMediaPlatform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  TIKTOK
}

enum SocialMediaPostStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum EmailCampaignStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  SENT
}

enum SalonStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ContentType {
  POST
  STORY
  REELS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponSource {
  MANUAL
  REDEMPTION
}

enum ReferralStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum PointsTransactionType {
  AFFILIATE_REFERRAL
  AFFILIATE_PURCHASE
  REDEMPTION
  MANUAL_ADJUSTMENT
}

enum PointsConfigurationActionType {
  REFERRAL_SIGNUP
  REFERRAL_FIRST_ORDER
  REFERRAL_REPEAT_ORDER
  OWN_PURCHASE
}

enum RedemptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  USED
}

enum AffiliateTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum MegaMenuType {
  SHOP
  ABOUT
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PageStatus {
  DRAFT
  PUBLISHED
  PENDING
}

enum AdminLogActionType {
  CREATE
  UPDATE
  DELETE
  VIEW
  EXPORT
  IMPORT
  APPROVE
  REJECT
  ACTIVATE
  DEACTIVATE
  LOGIN
  LOGOUT
  BULK_OPERATION
  OTHER
}

enum TrainingBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TrainingFormat {
  ONLINE
  PRESENTIAL
  HYBRID
}
